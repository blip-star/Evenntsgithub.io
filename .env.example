# Copy to .env and fill in values

# Django
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Defaults
EVENTS_COUNTY=Nairobi
EVENTS_DAYS_AHEAD=30
# Web UI port (use 8001 — Supreme Trader trading bot uses 8000)
EVENTS_PORT=8001
EVENT_PREFERENCES=live music,comedy,art,festivals,food,tech,networking,outdoor

# Telegram — comma-separated chat IDs for multiple users
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=

# Phone push via ntfy.sh (FREE) — install ntfy app, subscribe to unique topic
NTFY_TOPIC=nairobi-events-yourname
NTFY_SERVER=https://ntfy.sh

# WhatsApp — CallMeBot is FREE (recommended)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO_NUMBERS=0718584873
WHATSAPP_RECOMMENDED_ONLY=true
CALLMEBOT_API_KEY=

# Twilio (optional) — set WHATSAPP_PROVIDER=twilio and fill these in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=+14155238886
WHATSAPP_INCLUDE_POSTER=true

# Re-alert when event details change
ALERT_ON_CHANGES=true

# Weather — Open-Meteo works FREE without a key (enabled by default)
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Nairobi,KE
WEATHER_TIMEZONE=Africa/Nairobi
WEATHER_LAT=-1.2864
WEATHER_LON=36.8172

# AI / LLM (optional – uses heuristic fallback without key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Autoscan + social (X, Facebook, Instagram)
AUTOSCAN_ENABLED=true
AUTOSCAN_INTERVAL_HOURS=6
SOCIAL_SCAN_ENABLED=true
SOCIAL_PLATFORMS=x,facebook,instagram
