# Copy to .env and fill in values

# Defaults
EVENTS_COUNTY=Nairobi
EVENTS_DAYS_AHEAD=30
EVENTS_PORT=8001
EVENT_PREFERENCES=live music,comedy,art,festivals,food,tech,networking,outdoor

# Telegram (free, real-time) – create bot via @BotFather, get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone push via ntfy.sh (FREE) — install ntfy app, subscribe to this unique topic
NTFY_TOPIC=nairobi-events-718584873
NTFY_SERVER=https://ntfy.sh

# WhatsApp — CallMeBot is FREE (no Twilio account needed)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO_NUMBERS=0718584873
WHATSAPP_RECOMMENDED_ONLY=true
CALLMEBOT_API_KEY=+34 644 44 96 62

# Twilio (optional alternative) — only if WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=+14155238886

# OpenWeatherMap (optional) – free tier at openweathermap.org
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Nairobi,KE

# AI / LLM (optional – uses heuristic fallback without key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Autoscan + social
AUTOSCAN_ENABLED=true
AUTOSCAN_INTERVAL_HOURS=6
SOCIAL_SCAN_ENABLED=true


DEBUG=False

DEBUG=True

DEBUG=True
